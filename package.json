{
  "name": "@zeam-labs/x402-mcp-bridge",
  "version": "3.0.2",
  "description": "Put a wallet in front of any x402-paid MCP server: pay per call, or buy time and ride a ZEAM :: Pass line. Stock MCP clients cannot construct x402 payments; this one does, and proxies your existing client through it.",
  "keywords": [
    "x402",
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "agents",
    "wallet",
    "payments",
    "micropayments",
    "batch-settlement",
    "usdc",
    "base",
    "zeam",
    "zeam-pass",
    "prism"
  ],
  "author": "ZEAM Labs, LLC <info@zeamlabs.com> (https://www.zeamlabs.com)",
  "type": "module",
  "bin": {
    "x402-mcp-bridge": "index.mjs"
  },
  "main": "index.mjs",
  "scripts": {
    "test": "node test/exact.mjs && node test/fetch.mjs && node --test test/*.test.mjs",
    "smoke": "node --test test/smoke-pass.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "client.mjs",
    "ethers.mjs",
    "fetch.mjs",
    "index.mjs",
    "line.mjs",
    "pay.mjs",
    "refund.mjs",
    "viem.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/evm": "2.22.0",
    "@x402/fetch": "2.22.0",
    "@x402/mcp": "2.22.0",
    "viem": "2.55.16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeam-labs/x402-mcp-bridge"
  },
  "homepage": "https://zeamprism.com/connect",
  "exports": {
    ".": "./index.mjs",
    "./viem": "./viem.mjs",
    "./ethers": "./ethers.mjs"
  },
  "devDependencies": {
    "ethers": "6.17.0"
  },
  "peerDependencies": {
    "ethers": ">=6"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  }
}
